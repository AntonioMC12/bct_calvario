# Copia este archivo a .env para configurar una instancia de piloto.
# Ejecuta node --env-file=.env scripts/serve.mjs
# El servidor escucha en 127.0.0.1. El proxy TLS conserva la cabecera Host.
PORT=3000
CALVARIO_DB=data/calvario.sqlite

# Supabase. Copia la URL de Connect > Session pooler (puerto 5432) y el certificado de la base.
# Con estas variables, npm start usa PostgreSQL y npm run demo sigue usando SQLite.
# CALVARIO_DATABASE_URL=postgresql://postgres.REFERENCIA:CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres
# CALVARIO_DATABASE_CA=C:/ruta-privada/supabase-ca.crt

# Sin estas variables, el correo técnico se escribe en el buzón de archivos.
# CALVARIO_MAILBOX=data/mailbox
# CALVARIO_PUBLIC_ORIGIN=https://calvario.example.invalid
# CALVARIO_SMTP_URL=smtps://USUARIO:CONTRASENA@smtp.example.invalid:465
# CALVARIO_MAIL_FROM=calvario@example.invalid

# Acceso con Google mediante Firebase Authentication.
# Copia projectId, apiKey y appId de la aplicación web del proyecto.
# CALVARIO_FIREBASE_PROJECT_ID=calvario-ejemplo
# CALVARIO_FIREBASE_API_KEY=
# CALVARIO_FIREBASE_APP_ID=
# GOOGLE_APPLICATION_CREDENTIALS=C:/ruta-privada/calvario-firebase.json

# Web Push. Genera las claves con npx --no-install web-push generate-vapid-keys --json
# CALVARIO_PUSH_PUBLIC_KEY=
# CALVARIO_PUSH_PRIVATE_KEY=
# CALVARIO_PUSH_CONTACT=mailto:acceso@example.invalid
