{
  "name": "bct-calvario",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Aplicación de gestión de la banda Calvario",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/serve.mjs",
    "dev": "node --env-file-if-exists=.env --watch scripts/serve.mjs",
    "demo": "node scripts/demo.mjs",
    "account": "node --env-file-if-exists=.env scripts/account.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "db:setup": "node --env-file-if-exists=.env scripts/database.mjs setup",
    "db:check": "node --env-file-if-exists=.env scripts/database.mjs check",
    "db:import": "node --env-file-if-exists=.env scripts/database.mjs import",
    "build:pilot": "node scripts/build-pilot.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:postgres": "node scripts/test-postgres.mjs"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "firebase-admin": "14.5.1",
    "nodemailer": "10.6.1",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "web-push": "4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@electric-sql/pglite-socket": "0.3.0"
  }
}
